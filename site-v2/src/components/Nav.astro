---
import { Image } from 'astro:assets';
import { nav } from '../content';
---

<header class="fixed inset-x-0 top-4 z-50 flex justify-center px-3 md:top-6">
  <nav
    aria-label="Main"
    class="glass relative flex items-center gap-1 rounded-full py-[7px] pr-[7px] pl-2"
  >
    <a href="#top" class="mr-2 inline-flex items-center gap-2.5 rounded-full text-[15px] font-semibold tracking-[-0.01em] md:mr-[18px]">
      <Image
        src={nav.portrait.src}
        alt={nav.portrait.alt}
        width={60}
        height={60}
        loading="eager"
        class="size-[30px] rounded-full object-cover"
      />
      {nav.name}
    </a>

    <ul class="hidden list-none items-center gap-1 p-0 m-0 md:flex">
      {
        nav.links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-full px-3.5 py-2.5 text-sm text-ink-2 transition-colors hover:text-ink">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      class="inline-flex min-h-[44px] items-center rounded-full px-3.5 text-sm text-ink-2 hover:text-ink md:hidden"
      aria-expanded="false"
      aria-controls="nav-menu"
      data-menu-toggle
    >
      Menu
    </button>

    <a
      href={nav.resume.href}
      class="ml-1 inline-flex min-h-[44px] items-center rounded-full bg-ink px-[18px] text-sm font-medium text-white transition-colors hover:bg-[#2a2b33] md:ml-2.5"
    >
      {nav.resume.label}
    </a>

    <ul
      id="nav-menu"
      hidden
      class="absolute top-[calc(100%+8px)] border border-[rgba(11,11,15,0.08)] bg-white right-0 left-0 m-0 list-none rounded-3xl p-2 md:hidden"
    >
      {
        nav.links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-2xl px-4 py-3 text-[15px] text-ink-2 hover:text-ink" data-menu-link>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    toggle.addEventListener('click', () => set(Boolean(menu.hidden)));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        set(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !toggle.closest('nav')?.contains(e.target as Node)) set(false);
    });
  }
</script>
