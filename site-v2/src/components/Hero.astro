---
import { Picture, getImage } from 'astro:assets';
import { hero } from '../content';

const hasVideo = Boolean(hero.video.mp4 || hero.video.webm);
const poster = hasVideo ? await getImage({ src: hero.image.src, format: 'webp', width: 1280 }) : null;
---

<section id="top" class="on-dark relative isolate overflow-hidden bg-hero text-white">
  <div class="hero-media absolute inset-x-0 -z-20">
  <Picture
    src={hero.image.src}
    alt={hero.image.alt}
    formats={['webp']}
    fallbackFormat="jpg"
    widths={[640, 1024, 1280]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
  />
  {
    hasVideo && (
      <video
        class="absolute inset-0 h-full w-full object-cover"
        muted
        loop
        playsinline
        preload="none"
        poster={poster?.src}
        aria-hidden="true"
        data-hero-video
      >
        {hero.video.webm && <source src={hero.video.webm} type="video/webm" />}
        {hero.video.mp4 && <source src={hero.video.mp4} type="video/mp4" />}
      </video>
    )
  }
  </div>
  <div class="hero-mask absolute inset-0 -z-10 hidden lg:block" aria-hidden="true"></div>

  <div class="hero-text flex items-start px-[var(--gutter)] pb-16 lg:min-h-[clamp(640px,100svh,960px)] lg:items-center lg:pt-[104px] lg:pb-12">
    <div class="w-full max-w-[680px]">
      <p class="mono m-0 mb-[26px] text-mist lg:mb-[clamp(14px,2.6svh,26px)]">{hero.eyebrow}</p>
      <h1 class="t-display m-0 lg:text-[clamp(2.6rem,min(5.84vw,8.6svh),5.25rem)]">
        {hero.headline.main} <span class="accent-light text-accent-soft">{hero.headline.accent}</span>
      </h1>
      <p class="mt-[30px] mb-0 max-w-[580px] lg:mt-[clamp(16px,3.2svh,30px)] text-[17px] leading-[1.6] text-mist md:text-[19px]">{hero.body}</p>

      <dl class="m-0 mt-11 lg:mt-[clamp(20px,4.6svh,44px)] flex flex-wrap gap-x-10 gap-y-6">
        {
          hero.stats.map((s) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-1.5 text-[13px] text-mist-2">{s.label}</dt>
              <dd class="num m-0 text-[clamp(2.25rem,3.06vw,2.75rem)] leading-none font-semibold tracking-[-0.05em]">
                <span aria-hidden="true" data-count={s.value}>{s.value}</span>
                <span class="sr-only">{s.value}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-11 lg:mt-[clamp(20px,4.6svh,44px)] flex max-w-[580px] flex-wrap justify-end gap-2.5">
        <a href={hero.secondary.href} class="btn btn-ghost glass-dark">{hero.secondary.label}</a>
        <a href={hero.primary.href} class="btn btn-light">{hero.primary.label}</a>
      </div>
    </div>
  </div>
</section>
<div class="hero-to-page h-[80px] lg:h-[120px]" aria-hidden="true"></div>

<script>
  // Hero video: play only when motion is allowed, data saver is off and the hero is on screen.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let onScreen = true;
    const sync = () => {
      if (reduce.matches || saveData || !onScreen) video.pause();
      else video.play().catch(() => {});
    };
    new IntersectionObserver((entries) => {
      onScreen = entries[0]?.isIntersecting ?? true;
      sync();
    }).observe(video);
    reduce.addEventListener('change', sync);
  }
</script>
