---
import { Picture, getImage } from 'astro:assets';
import { hero } from '../content';

const hasVideo = Boolean(hero.video.mp4 || hero.video.webm);
const poster = hasVideo ? await getImage({ src: hero.image.src, format: 'webp', width: 1024 }) : null;
---

<section id="top" class="on-dark relative isolate overflow-hidden bg-hero text-white">
  <Picture
    src={hero.image.src}
    alt={hero.image.alt}
    formats={['webp']}
    fallbackFormat="jpg"
    widths={[640, 1024]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[78%_50%]"
  />
  {
    hasVideo && (
      <video
        class="absolute inset-0 -z-20 h-full w-full object-cover object-[78%_50%]"
        muted
        loop
        playsinline
        preload="none"
        poster={poster?.src}
        aria-hidden="true"
        data-hero-video
      >
        {hero.video.webm && <source src={hero.video.webm} type="video/webm" />}
        {hero.video.mp4 && <source src={hero.video.mp4} type="video/mp4" />}
      </video>
    )
  }
  <div class="hero-mask absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="flex min-h-[max(640px,100svh)] items-start px-[var(--gutter)] pt-28 pb-16 sm:pt-36 lg:min-h-[clamp(760px,100svh,960px)] lg:pt-[230px]">
    <div class="w-full max-w-[680px]">
      <p class="mono m-0 mb-[26px] text-mist">{hero.eyebrow}</p>
      <h1 class="t-display m-0">
        {hero.headline.main} <span class="accent-light text-accent-soft">{hero.headline.accent}</span>
      </h1>
      <p class="mt-[30px] mb-0 max-w-[580px] text-[17px] leading-[1.6] text-mist md:text-[19px]">{hero.body}</p>

      <dl class="m-0 mt-11 flex flex-wrap gap-x-10 gap-y-6">
        {
          hero.stats.map((s) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-1.5 text-[13px] text-mist-2">{s.label}</dt>
              <dd class="num m-0 text-[clamp(2.25rem,3.06vw,2.75rem)] leading-none font-semibold tracking-[-0.05em]">
                <span aria-hidden="true" data-count={s.value}>{s.value}</span>
                <span class="sr-only">{s.value}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-11 flex max-w-[580px] flex-wrap justify-end gap-2.5">
        <a href={hero.secondary.href} class="btn btn-ghost glass-dark">{hero.secondary.label}</a>
        <a href={hero.primary.href} class="btn btn-light">{hero.primary.label}</a>
      </div>
    </div>
  </div>
</section>
<div class="hero-to-page h-[80px] lg:h-[120px]" aria-hidden="true"></div>

{
  hasVideo && (
    <script>
      const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (video) {
        const sync = () => {
          if (reduce.matches) {
            video.pause();
          } else {
            video.play().catch(() => {});
          }
        };
        sync();
        reduce.addEventListener('change', sync);
      }
    </script>
  )
}
