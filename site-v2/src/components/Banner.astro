---
// Floating launch notice (bottom centre). Shown only while <html> has .has-banner, which an inline
// script in Base.astro sets before paint (not expired, not dismissed). Close remembers it.
import { banner } from '../content';
const active = Boolean(banner.text);
---

{
  active && (
    <div class="site-banner" role="region" aria-label="Announcement">
      <p class="m-0"><span aria-hidden="true" class="mr-1.5">⚠</span>{banner.text}</p>
      <button type="button" class="site-banner-close" aria-label={banner.closeLabel} data-banner-close data-until={banner.until}>
        <span aria-hidden="true">×</span>
      </button>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-banner-close]').forEach((btn) =>
    btn.addEventListener('click', () => {
      document.documentElement.classList.remove('has-banner');
      try {
        localStorage.setItem('banner-dismissed', btn.dataset.until ?? '1');
      } catch {
        /* storage blocked: the bar just comes back on the next visit */
      }
    }),
  );
</script>

<style>
  /* Floating notice, bottom centre. It overlays the page and never moves the layout. */
  .site-banner {
    position: fixed;
    left: 50%;
    bottom: 16px;
    z-index: 60;
    display: none;
    align-items: center;
    gap: 6px;
    width: max-content;
    max-width: calc(100% - 32px);
    transform: translateX(-50%);
    padding: 10px 46px 10px 18px;
    border: 1px solid rgba(11, 11, 15, 0.15);
    border-radius: 999px;
    background: #fbbf24; /* amber: warning / notice */
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
  }
  :global(html.has-banner) .site-banner {
    display: flex;
  }
  .site-banner-close {
    position: absolute;
    right: 7px;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }
  .site-banner-close:hover {
    background: rgba(11, 11, 15, 0.1);
  }
  .site-banner-close:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 0;
  }
</style>
