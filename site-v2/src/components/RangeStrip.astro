---
import { Picture } from 'astro:assets';
import { range } from '../content';

const tt = range.turntable;
const firstFrame = `${tt.basePath}1.${tt.ext}`;
// Card widths from the comp (720 / 520 / 460 at 1440 px), scaled down on phones.
const widths = ['w-[min(85vw,720px)]', 'w-[min(75vw,520px)]', 'w-[min(70vw,460px)]'];
---

<section id="range" aria-labelledby="range-title" class="pt-24 lg:pt-[140px]">
  <div data-reveal class="mb-9 flex flex-col gap-4 px-[var(--gutter)] md:flex-row md:items-end md:justify-between md:gap-8">
    <h2 id="range-title" class="t-h2 m-0">
      {range.title.main} <span class="accent-light text-accent">{range.title.accent}</span>
    </h2>
    <p class="m-0 max-w-[360px] text-base leading-[1.55] text-ink-2 md:text-right">{range.intro}</p>
  </div>

  <div
    class="strip flex items-end gap-4 overflow-x-auto px-[var(--gutter)] pb-4 sm:gap-6"
    tabindex="0"
    role="region"
    aria-label="3D work, scrolls sideways"
  >
    <figure class:list={['m-0 shrink-0', widths[0]]}>
      <div
        class="relative flex aspect-[720/420] cursor-grab touch-pan-y items-center justify-center overflow-hidden rounded-[28px] bg-white select-none active:cursor-grabbing"
        role="slider"
        tabindex="0"
        aria-label={`${tt.alt}. Use left and right arrow keys to rotate.`}
        aria-valuemin="0"
        aria-valuemax="359"
        aria-valuenow="0"
        aria-valuetext="0 degrees"
        data-turntable
        data-base={tt.basePath}
        data-ext={tt.ext}
        data-frames={tt.frames}
      >
        <img
          src={firstFrame}
          alt=""
          width="555"
          height="257"
          loading="lazy"
          decoding="async"
          draggable="false"
          class="pointer-events-none w-[86%] h-auto"
        />
      </div>
      <figcaption class="mt-3.5 flex justify-between gap-4 text-sm">
        <span class="font-semibold">{tt.caption}</span>
        <span class="mono text-ink-2">{tt.hint}</span>
      </figcaption>
    </figure>

    {
      range.items.map((item, i) => (
        <figure class:list={['m-0 shrink-0', widths[i + 1]]}>
          <Picture
            src={item.image.src}
            alt={item.image.alt}
            formats={['webp']}
    fallbackFormat="jpg"
            widths={[400, 720, 1040]}
            sizes="(min-width: 768px) 520px, 75vw"
            loading="lazy"
            class:list={['block h-auto w-full rounded-[28px] object-cover', i === 0 ? 'aspect-[520/340]' : 'aspect-[460/300]']}
          />
          <figcaption class="mt-3.5 text-sm font-semibold">{item.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-turntable]').forEach((stage) => {
    const img = stage.querySelector('img')!;
    const base = stage.dataset.base!;
    const ext = stage.dataset.ext!;
    const count = Number(stage.dataset.frames);
    const src = (i: number) => `${base}${i + 1}.${ext}`;
    let frame = 0;
    let loaded = false;

    // Fetch every frame once the card is near the viewport, so dragging is smooth.
    const preload = () => {
      if (loaded) return;
      loaded = true;
      for (let i = 1; i < count; i++) {
        const im = new Image();
        im.decoding = 'async';
        im.src = src(i);
      }
    };
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting)) {
        preload();
        io.disconnect();
      }
    }, { rootMargin: '300px' }).observe(stage);

    const show = (i: number) => {
      frame = ((i % count) + count) % count;
      img.src = src(frame);
      const deg = Math.round((frame / count) * 360);
      stage.setAttribute('aria-valuenow', String(deg));
      stage.setAttribute('aria-valuetext', `${deg} degrees`);
    };

    // Drag: ~8 px of horizontal travel per frame.
    let startX = 0;
    let startFrame = 0;
    let dragging = false;
    stage.addEventListener('pointerdown', (e) => {
      dragging = true;
      startX = e.clientX;
      startFrame = frame;
      preload();
      stage.setPointerCapture(e.pointerId);
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      show(startFrame - Math.round((e.clientX - startX) / 8));
    });
    const end = () => (dragging = false);
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);

    stage.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 5 : 1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') show(frame + step);
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') show(frame - step);
      else if (e.key === 'Home') show(0);
      else return;
      e.preventDefault();
    });
  });
</script>
