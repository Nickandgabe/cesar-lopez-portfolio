---
// Career-wide strip. Dark, continuing the hero, with the hero's soft violet as accent.
// Motion (all off under prefers-reduced-motion): column rules draw in, numbers count up,
// industry pills appear one after another.
import { career } from '../content';
---

<section aria-labelledby="career-title" class="career on-dark bg-hero px-[var(--gutter)] pt-10 pb-14 text-white lg:pt-16 lg:pb-20">
  <div data-reveal class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-8 lg:mb-16">
    <h2 id="career-title" class="t-h2 m-0">{career.title}</h2>
    <p class="m-0 max-w-[420px] text-base leading-[1.55] text-mist md:text-right">{career.subtitle}</p>
  </div>

  <ul class="m-0 grid list-none grid-cols-2 gap-x-6 gap-y-12 p-0 sm:gap-x-10 lg:grid-cols-4 lg:gap-x-10">
    {
      career.items.map((m, i) => (
        <li data-reveal class="career-col relative pl-5 lg:pl-7" style={`transition-delay:${i * 110}ms;--d:${i * 110}ms`}>
          <p class="num t-metric m-0 text-white">
            <span data-count={m.value}>{m.value}</span>
            <span class="text-accent-soft">{m.suffix}</span>
          </p>
          <p class="mono mt-5 mb-0 text-accent-soft">{m.unit}</p>
          <p class="mt-2.5 mb-0 max-w-[290px] text-[15px] leading-relaxed text-mist">{m.detail}</p>
        </li>
      ))
    }
  </ul>

  <div class="mt-14 border-t border-white/10 pt-8 lg:mt-20">
    <p class="mono m-0 mb-4 text-mist-2">{career.industriesLabel}</p>
    <ul class="m-0 flex list-none flex-wrap gap-2 p-0" aria-label={career.industriesLabel}>
      {
        career.industries.map((name, i) => (
          <li data-reveal class="rounded-full border border-white/15 px-3.5 py-1.5 text-[13px] text-mist" style={`transition-delay:${200 + i * 45}ms`}>
            {name}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Vertical rule on each stat column; it draws top-to-bottom when the column reveals. */
  .career-col::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, rgba(157, 180, 255, 0.7), rgba(255, 255, 255, 0.08));
    transform-origin: top;
  }
  :global(.motion) .career-col::before {
    transform: scaleY(0);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--d, 0ms);
  }
  :global(.motion) .career-col:global(.is-visible)::before {
    transform: scaleY(1);
  }
</style>
