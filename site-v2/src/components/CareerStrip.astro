---
import StatGrid from './StatGrid.astro';
import { career } from '../content';
---

<section aria-labelledby="career-title" class="px-[var(--gutter)] pt-10 pb-20 lg:pt-[60px] lg:pb-[120px]">
  <div data-reveal class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-8">
    <h2 id="career-title" class="t-h2 m-0">{career.title}</h2>
    <p class="m-0 max-w-[400px] text-base leading-[1.55] text-ink-2 md:text-right">{career.subtitle}</p>
  </div>
  <StatGrid items={career.items} />
  <p class="mt-12 mb-0 border-t border-[rgba(11,11,15,0.12)] pt-5 text-sm leading-relaxed text-ink-2">
    {career.industries}
  </p>
</section>
