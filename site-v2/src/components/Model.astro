---
import { model } from '../content';

// Double Diamond: each diamond is split into an opening half (agents) and a closing half (people).
// viewBox 0 0 960 240; diamonds are 440 wide, 200 tall, centred on y = 110.
const halves = [
  { d: 'M20 110 L240 10 L240 210 Z', who: 'agents', n: '01', x: 160 },
  { d: 'M240 10 L460 110 L240 210 Z', who: 'people', n: '02', x: 320 },
  { d: 'M500 110 L720 10 L720 210 Z', who: 'agents', n: '03', x: 640 },
  { d: 'M720 10 L940 110 L720 210 Z', who: 'people', n: '04', x: 800 },
];
---

<section id="model" aria-labelledby="model-title" class="px-[var(--gutter)] pt-8 pb-24 lg:pt-10 lg:pb-[140px]">
  <div data-reveal class="mb-12 flex flex-col gap-5">
    <div>
      <p class="mono m-0 mb-4 text-ink-2">{model.eyebrow}</p>
      <h2 id="model-title" class="t-h2 m-0">
        {model.title.main} <span class="accent-light text-accent">{model.title.accent}</span>
      </h2>
    </div>
    <p class="m-0 max-w-[620px] text-lg leading-[1.55] text-ink-2">{model.intro}</p>
  </div>

  <figure data-reveal class="m-0 mb-12">
    <svg viewBox="0 0 960 220" class="block h-auto w-full max-w-[960px]" role="img" aria-labelledby="model-svg-title">
      <title id="model-svg-title">
        Double Diamond diagram: agents explore, people decide, agents build, guardrails protect what ships — on a base of the design system.
      </title>
      {
        halves.map((h) => (
          <g>
            <path
              d={h.d}
              fill={h.who === 'agents' ? 'rgba(11,61,255,0.10)' : 'rgba(11,11,15,0.05)'}
              stroke={h.who === 'agents' ? '#0B3DFF' : '#0B0B0F'}
              stroke-width="1.5"
              stroke-linejoin="round"
            />
            <text
              x={h.x}
              y="121"
              text-anchor="middle"
              fill={h.who === 'agents' ? '#0B3DFF' : '#0B0B0F'}
              font-family="Geist Mono Variable, monospace"
              font-size="30"
            >
              {h.n}
            </text>
          </g>
        ))
      }
    </svg>
    <div class="mt-3 max-w-[960px] rounded-full bg-ink px-5 py-2.5 text-center text-sm font-medium text-white">{model.base}</div>
    <figcaption class="mono mt-4 flex flex-wrap gap-x-6 gap-y-2 text-ink-2">
      <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-2.5 rounded-sm border border-accent bg-[rgba(11,61,255,0.10)]"></span>{model.legend.agents}</span>
      <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-2.5 rounded-sm border border-ink bg-[rgba(11,11,15,0.05)]"></span>{model.legend.people}</span>
    </figcaption>
  </figure>

  <ol class="m-0 grid list-none grid-cols-1 gap-x-10 p-0 sm:grid-cols-2 lg:grid-cols-4">
    {
      model.steps.map((s, i) => (
        <li data-reveal style={`transition-delay:${i * 80}ms`} class="border-t border-[rgba(11,11,15,0.12)] py-6">
          <span class:list={['num text-lg', s.who === 'agents' ? 'text-accent' : 'text-ink']}>{s.n}</span>
          <h3 class="mt-3 mb-0 text-xl font-semibold tracking-[-0.01em]">{s.title}</h3>
          <p class="mt-2 mb-0 text-base leading-normal text-ink-2">{s.detail}</p>
        </li>
      ))
    }
  </ol>

  <p data-reveal class="t-lead mt-8 mb-0 max-w-[760px] text-ink-2">{model.proof}</p>
</section>
