---
import { metrics } from '../content';
---

<section aria-label="Results" class="px-[var(--gutter)] pt-10 pb-20 lg:pt-[60px] lg:pb-[120px]">
  <ul class="m-0 grid list-none grid-cols-1 gap-10 p-0 sm:grid-cols-2 lg:grid-cols-4">
    {
      metrics.items.map((m, i) => (
        <li data-reveal style={`transition-delay:${i * 80}ms`}>
          <p class="num t-metric m-0">
            {m.prefix}<span data-count={m.value}>{m.value}</span><span class="text-accent">{m.suffix}</span>
          </p>
          <p class="mt-3.5 mb-0 text-base leading-normal text-ink-2">
            {m.lines[0]}
            <br />
            {m.lines[1]}
          </p>
        </li>
      ))
    }
  </ul>
  <p class="mono mt-12 mb-0 border-t border-[rgba(11,11,15,0.12)] pt-5 text-ink-2">{metrics.note}</p>
</section>
