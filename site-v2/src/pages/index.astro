---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import CareerStrip from '../components/CareerStrip.astro';
import CaseScene from '../components/CaseScene.astro';
import Leadership from '../components/Leadership.astro';
import AllWork from '../components/AllWork.astro';
import Closing from '../components/Closing.astro';
import { work } from '../content';

const [first, second, third] = work.cases;
---

<Base>
  <Nav />
  <main id="main" tabindex="-1" class="mx-auto max-w-[1920px] overflow-x-clip">
    <Hero />
    <CareerStrip />
    <div class="hero-to-page h-[80px] lg:h-[120px]" aria-hidden="true"></div>
    <div id="work">
      <CaseScene item={first} eyebrow={work.eyebrow} />
      <div class="to-dark h-[80px] lg:h-[120px]" aria-hidden="true"></div>
      <CaseScene item={second} />
      <div class="to-light h-[80px] lg:h-[120px]" aria-hidden="true"></div>
      <CaseScene item={third} />
    </div>
    <Leadership />
    <AllWork />
  </main>
  <Closing />
</Base>
